# Copy to .env and fill secrets. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/product3
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:3000
# Meta WhatsApp Cloud API (optional — sends are mock-logged when empty).
# PHONE_ID: Meta dashboard → WhatsApp → API Setup → Phone number ID.
# TOKEN: System User token with whatsapp_business_messaging scope.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
CHECK_INTERVAL=* * * * *
LOG_RETENTION_DAYS=90
